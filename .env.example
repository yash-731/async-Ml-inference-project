# Copy to .env for running outside Docker. docker-compose sets these itself.
ENVIRONMENT=development
LOG_LEVEL=INFO
JSON_LOGS=true

DATABASE_URL=postgresql+psycopg://forecast:forecast@localhost:5432/forecast
REDIS_URL=redis://localhost:6379/0

STORAGE_DIR=./var/uploads
MAX_UPLOAD_BYTES=10485760
MIN_ROWS=14
DATE_COLUMN=date
VALUE_COLUMN=value

UPLOAD_RATE_LIMIT=10/minute
RATE_LIMIT_ENABLED=true

FORECAST_HORIZON=14
DEFAULT_MODEL=seasonal_naive_trend

TASK_MAX_RETRIES=3
TASK_RETRY_BACKOFF=2
TASK_RETRY_BACKOFF_MAX=120

# Used only by the test suite
TEST_DATABASE_URL=postgresql+psycopg://forecast:forecast@localhost:5432/forecast_test
